root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# RU: Windows PowerShell 5.1 требует BOM для исходников с кириллицей.
# EN: Windows PowerShell 5.1 requires a BOM for source files containing Cyrillic.
[*.ps1]
charset = utf-8-bom

[*.{yml,yaml,json}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cmd]
end_of_line = crlf
